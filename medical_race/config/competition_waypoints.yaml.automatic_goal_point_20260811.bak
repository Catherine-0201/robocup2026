# 导航点坐标配置
#
# 使用方法：
# 1. 保持原来的 get_point.launch 不变；
# 2. 在界面中读取 /tf_xy 显示的现场 x/y；
# 3. 严格按“护士台、床位1、床位3”的顺序填写 goal_point；
# 4. home_point 单独填写家的坐标；
# 5. 运行时不通过这些坐标计算到达距离，只等待 /target_done 递增。
#
# 下列坐标沿用当前工程已有值，实车测试前请替换为现场记录值。

# 顺序固定：护士台、床位1、床位3
goal_point:
  - [1.00, 0.00]
  - [5.30, 2.00]
  - [5.30, -1.60]

# 三个目标点的朝向，单位为弧度；顺序与 goal_point 相同。
goal_yaw:
  - 0.00
  - 0.00
  - 0.00

# 家/起点坐标和朝向。
home_point: [0.00, 0.00]
home_yaw: 0.00

# 护士台、床位1、床位3到达后的统一停留时间。
hold_seconds: 5.0
