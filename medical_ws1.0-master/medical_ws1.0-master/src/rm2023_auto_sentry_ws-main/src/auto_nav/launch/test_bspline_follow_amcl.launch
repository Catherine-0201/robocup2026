<?xml version="1.0"?>
<launch>
  <!--
    AMCL version of the original B-spline navigation launch.
    It deliberately does not run robcup/amcl_pub or any localization node.
    AMCL must be the only publisher of map -> odom and /amcl_pose.
  -->
  <param name="/use_sim_time" value="false"/>

  <node pkg="move_base" type="move_base" name="move_base" respawn="false" output="screen">
    <rosparam file="$(find auto_nav)/config/point_pid_params/test_medical_params/test_costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find auto_nav)/config/point_pid_params/test_medical_params/test_costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find auto_nav)/config/point_pid_params/test_medical_params/test_local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_nav)/config/point_pid_params/test_medical_params/test_global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_nav)/config/point_pid_params/test_medical_params/test_teb_local_planner_params.yaml"
              command="load"/>

    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="planner_frequency" value="1.0"/>
    <param name="planner_patience" value="5.0"/>
    <param name="use_dijkstra" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
    <remap from="/cmd_vel" to="/move_base_cmd_vel"/>
  </node>

  <!-- Original B-spline executable and parameters. -->
  <node pkg="auto_nav" type="test_Bspline_follow"
        name="bspline_position_follow_amcl" respawn="true" output="screen">
    <param name="a_max" value="0.2"/>
    <param name="d_max" value="0.2"/>
    <param name="a_lat_max" value="0.1"/>
    <param name="max_linear_speed" value="0.5"/>
    <param name="max_angular_speed" value="0.2"/>
    <param name="lookahead_idx" value="3"/>
    <param name="goal_dist_tolerance" value="0.04"/>
    <param name="yaw_pid" value="0.6"/>
  </node>

  <node pkg="auto_nav" type="cmd_vel_monitor"
        name="cmd_vel_monitor" respawn="true" output="screen"/>
</launch>
