<launch>
  <!-- 设置时间同步为实时（非回放） -->
  <param name="use_sim_time" value="false"/>
  <!-- 启动话题转换节点 -->
  <node pkg="medical_race" type="convert_odom.py" name="odom_converter" output="screen"/>
  <!-- 启动 Gmapping 节点 -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <!-- 坐标系配置 -->
    <param name="base_frame" value="base_footprint"/> <!-- 底盘坐标系 -->
    <param name="odom_frame" value="odom"/> <!-- 里程计坐标系 -->
    <param name="map_frame" value="map"/> <!-- 地图坐标系 -->

    <!-- 话题重映射 -->
    <remap from="scan" to="/scan"/>
    <remap from="odom" to="/odom_converted"/> <!-- 使用转换后的 Odometry 话题 -->

    <!-- Gmapping 参数（适配 RPLIDAR A3） -->
    <param name="maxUrange" value="20.0"/> <!-- RPLIDAR A3 最大测距范围 -->
    <param name="maxRange" value="30.0"/> <!-- 最大有效范围 -->
    <param name="map_update_interval" value="0.1"/> <!-- 地图更新间隔（秒） -->
    <param name="minimumScore" value="50"/> <!-- 粒子滤波得分阈值 -->
    <param name="sigma" value="0.05"/> <!-- 激光测量噪声标准差 -->
    <param name="kernelSize" value="3"/> <!-- 激光匹配核大小 -->
    <param name="lstep" value="0.05"/> <!-- 线性步长优化 -->
    <param name="astep" value="0.05"/> <!-- 角度步长优化 -->
    <param name="iterations" value="5"/> <!-- 粒子滤波迭代次数 -->
    <param name="lsigma" value="0.075"/> <!-- 激光似然标准差 -->
    <param name="ogain" value="3.0"/> <!-- 里程计增益 -->
    <param name="lskip" value="0"/> <!-- 跳过激光点数（0 表示全用） -->
    <param name="srr" value="0.01"/> <!-- 线性移动噪声 -->
    <param name="srt" value="0.02"/> <!-- 线性-角度噪声 -->
    <param name="str" value="0.01"/> <!-- 角度-线性噪声 -->
    <param name="stt" value="0.02"/> <!-- 角度-角度噪声 -->
    <param name="linearUpdate" value="0.05"/> <!-- 线性移动触发更新（米） -->
    <param name="angularUpdate" value="0.436"/> <!-- 角度移动触发更新（弧度，约25°） -->
    <param name="temporalUpdate" value="-1.0"/> <!-- 禁用时间更新 -->
    <param name="resampleThreshold" value="0.5"/> <!-- 重采样阈值 -->
    <param name="particles" value="80"/> <!-- 粒子数（Jetson NX 适配） -->
    <param name="xmin" value="-10.0"/> <!-- 地图X轴范围 -->
    <param name="xmax" value="10.0"/>
    <param name="ymin" value="-10.0"/> <!-- 地图Y轴范围 -->
    <param name="ymax" value="10.0"/>
    <param name="delta" value="0.05"/> <!-- 地图分辨率（米） -->
    <param name="llsamplerange" value="0.01"/> <!-- 里程计噪声范围 -->
    <param name="llsamplestep" value="0.01"/> <!-- 里程计噪声步长 -->
    <param name="lasamplerange" value="0.005"/> <!-- 激光噪声范围 -->
    <param name="lasamplestep" value="0.005"/> <!-- 激光噪声步长 -->
  </node>

  

  <!-- 如果有 URDF 文件，启用以下节点 -->
  <!-- <node pkg="joint_state_publisher" name="joint_state_publisher" type="joint_state_publisher" /> -->
  <!-- <node pkg="robot_state_publisher" name="robot_state_publisher" type="robot_state_publisher" /> -->

  <!-- 启动 RViz 并加载配置文件 -->
  <node pkg="rviz" type="rviz" name="rviz" output="screen" args="-d $(find medical_race)/launch/gmapping.rviz"/>
</launch>
